{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.output", "**/.wxt", "apps"]
}
